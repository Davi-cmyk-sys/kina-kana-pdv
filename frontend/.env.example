# Kina Kana PDV — variáveis de ambiente do FRONTEND (Vite)
# Copie para frontend/.env se quiser sobrescrever os padrões.
# Variáveis do Vite precisam começar com VITE_ para ficarem disponíveis no navegador.

# Limite (em R$) a partir do qual a tela de desconto exige PIN de gerente.
# Deve ser igual ao DISCOUNT_AUTH_LIMIT configurado no backend/.env.
VITE_DISCOUNT_AUTH_LIMIT=10
