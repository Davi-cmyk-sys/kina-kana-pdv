# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto no Supabase (Project Settings → API). O .env.local nunca é
# enviado para o GitHub (veja o .gitignore) — cada pessoa/ambiente tem o seu.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: esta chave dá acesso total ao banco (ignora as regras de
# segurança). Só existe no servidor, nunca é usada no navegador, e NUNCA
# deve levar o prefixo NEXT_PUBLIC_. Copie a chave "service_role" em
# Project Settings → API Keys (é diferente da chave publishable acima).
SUPABASE_SERVICE_ROLE_KEY=
